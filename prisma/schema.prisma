generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ACCOUNTANT
  CONTACT
}

enum ContactType {
  CUSTOMER
  VENDOR
  BOTH
}

enum ProductType {
  GOODS
  SERVICE
  COMBO
}

enum AccountType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  CAPITAL
}

enum AccountSubType {
  CASH
  BANK
  DEBTOR
  CREDITOR
  SALE
  PURCHASE
  OTHER
  CAPITAL
}

enum JournalType {
  SALES
  PURCHASE
  BANK
  CASH
  GENERAL
}

enum EntryStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum DocStatus {
  DRAFT
  CONFIRMED
  PARTIAL
  PAID
  CANCELLED
  REVISED
}

enum BudgetStatus {
  DRAFT
  CONFIRMED
  REVISED
  CANCELLED
}

enum AnalyticType {
  INCOME
  EXPENSE
}

enum PayVia {
  CASH
  BANK
}

model User {
  id           String   @id @default(cuid())
  loginId      String   @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(ACCOUNTANT)
  contactId    String?  @unique
  contact      Contact? @relation(fields: [contactId], references: [id])
  createdAt    DateTime @default(now())
}

model Contact {
  id               String            @id @default(cuid())
  name             String
  type             ContactType       @default(CUSTOMER)
  email            String            @unique
  mobile           String?
  street           String?
  city             String?
  state            String?
  pincode          String?
  image            String?
  user             User?
  customerInvoices CustomerInvoice[]
  salesOrders      SalesOrder[]
  vendorBills      VendorBill[]
  purchaseOrders   PurchaseOrder[]
  payments         Payment[]
  createdAt        DateTime          @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  type        ProductType @default(GOODS)
  salesPrice  Float
  cost        Float
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  image       String?
  createdAt   DateTime @default(now())
}

model Account {
  id         String          @id @default(cuid())
  code       String?         @unique
  name       String          @unique
  type       AccountType
  subtype    AccountSubType  @default(OTHER)
  isArchived Boolean         @default(false)
}

model Journal {
  id               String        @id @default(cuid())
  code             String?       @unique
  name             String        @unique
  type             JournalType
  defaultDebitId   String?
  defaultCreditId  String?
  defaultAccountId String?
  entries          JournalEntry[]
}

model JournalEntry {
  id              String        @id @default(cuid())
  journalId       String
  journal         Journal       @relation(fields: [journalId], references: [id])
  entryNumber     String?       @unique
  date            DateTime      @default(now())
  reference       String
  status          EntryStatus   @default(POSTED)
  sourceType      String?
  sourceId        String?
  narration       String?
  postedAt        DateTime?
  reversedAt      DateTime?
  reversedEntryId String?       @unique
  reversedEntry   JournalEntry? @relation("JournalEntryReversals", fields: [reversedEntryId], references: [id])
  reversals       JournalEntry? @relation("JournalEntryReversals")
  lines           JournalLine[]
  createdAt       DateTime      @default(now())

  @@index([journalId])
  @@index([status])
  @@index([date])
}

model JournalLine {
  id                String       @id @default(cuid())
  entryId           String
  entry             JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId         String
  partnerId         String?
  analyticId        String?
  analyticAccountId String?
  narration         String?
  lineLabel         String?
  matchedLineId     String?
  debit             Float        @default(0)
  credit            Float        @default(0)

  @@index([entryId])
  @@index([accountId])
  @@index([partnerId])
  @@index([analyticId])
}

model Analytic {
  id   String       @id @default(cuid())
  name String       @unique
  type AnalyticType
}

model Budget {
  id            String       @id @default(cuid())
  name          String
  start         DateTime
  end           DateTime
  responsibleId String?
  status        BudgetStatus @default(DRAFT)
  revisionOfId  String?
  lines         BudgetLine[]
  createdAt     DateTime @default(now())

  @@index([status])
  @@index([start, end])
}

model BudgetLine {
  id             String   @id @default(cuid())
  budgetId       String
  budget         Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  analyticId     String
  type           AnalyticType
  committed      Float
  achievedCached Float @default(0)

  @@index([budgetId])
  @@index([analyticId])
}

// ---- Transactions ----
model PurchaseOrder {
  id        String              @id @default(cuid())
  no        String              @unique
  vendorId  String
  vendor    Contact             @relation(fields: [vendorId], references: [id])
  date      DateTime            @default(now())
  status    DocStatus           @default(DRAFT)
  subtotal  Float               @default(0)
  lines     PurchaseOrderLine[]
  createdAt DateTime            @default(now())

  @@index([vendorId])
  @@index([status])
  @@index([date])
}

model PurchaseOrderLine {
  id         String        @id @default(cuid())
  orderId    String
  order      PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  analyticId String?
  qty        Float
  unitPrice  Float
  total      Float

  @@index([orderId])
  @@index([productId])
}

model VendorBill {
  id        String           @id @default(cuid())
  no        String           @unique
  vendorId  String
  vendor    Contact          @relation(fields: [vendorId], references: [id])
  poId      String?
  billRef   String
  billDate  DateTime         @default(now())
  dueDate   DateTime
  status    DocStatus        @default(DRAFT)
  subtotal  Float            @default(0)
  paid      Float            @default(0)
  due       Float            @default(0)
  lines     VendorBillLine[]
  payments  Payment[]
  createdAt DateTime         @default(now())

  @@index([vendorId])
  @@index([status])
  @@index([billDate])
  @@index([dueDate])
}

model VendorBillLine {
  id         String     @id @default(cuid())
  billId     String
  bill       VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId  String
  analyticId String?
  qty        Float
  unitPrice  Float
  total      Float

  @@index([billId])
  @@index([productId])
}

model SalesOrder {
  id         String           @id @default(cuid())
  no         String           @unique
  customerId String
  customer   Contact          @relation(fields: [customerId], references: [id])
  date       DateTime         @default(now())
  status     DocStatus        @default(DRAFT)
  subtotal   Float            @default(0)
  taxTotal   Float            @default(0)
  total      Float            @default(0)
  lines      SalesOrderLine[]
  createdAt  DateTime         @default(now())

  @@index([customerId])
  @@index([status])
  @@index([date])
}

model SalesOrderLine {
  id         String     @id @default(cuid())
  orderId    String
  order      SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  analyticId String?
  qty        Float
  unitPrice  Float
  tax        Float      @default(0)
  total      Float

  @@index([orderId])
  @@index([productId])
}

model CustomerInvoice {
  id         String                @id @default(cuid())
  no         String                @unique
  customerId String
  customer   Contact               @relation(fields: [customerId], references: [id])
  soId       String?
  invRef     String
  invDate    DateTime              @default(now())
  dueDate    DateTime
  status     DocStatus             @default(DRAFT)
  subtotal   Float                 @default(0)
  taxTotal   Float                 @default(0)
  total      Float                 @default(0)
  paid       Float                 @default(0)
  due        Float                 @default(0)
  lines      CustomerInvoiceLine[]
  payments   Payment[]
  createdAt  DateTime              @default(now())

  @@index([customerId])
  @@index([status])
  @@index([invDate])
  @@index([dueDate])
}

model CustomerInvoiceLine {
  id         String          @id @default(cuid())
  invoiceId  String
  invoice    CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId  String
  analyticId String?
  qty        Float
  unitPrice  Float
  tax        Float           @default(0)
  total      Float

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id             String           @id @default(cuid())
  partnerId      String
  partner        Contact          @relation(fields: [partnerId], references: [id])
  billId         String?
  bill           VendorBill?      @relation(fields: [billId], references: [id])
  invoiceId      String?
  invoice        CustomerInvoice? @relation(fields: [invoiceId], references: [id])
  amount         Float
  date           DateTime         @default(now())
  via            PayVia           @default(BANK)
  note           String?
  journalEntryId String?
  createdAt      DateTime         @default(now())

  @@index([partnerId])
  @@index([billId])
  @@index([invoiceId])
  @@index([date])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}


